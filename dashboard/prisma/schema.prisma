// Prisma Schema for 2-Tier Digital Wedding Invitation Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Template {
  id             String            @id @default(cuid())
  name           String
  description    String?
  thumbnailUrl   String?
  globalSettings Json              @default("{}") // Store theme colors, fonts, music, global CSS
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sections       TemplateSection[]
  invitations    UserInvitation[]

  @@map("templates")
}

model TemplateSection {
  id           String   @id @default(cuid())
  templateId   String
  template     Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sectionOrder Int      // 1 to 12 sections
  sectionType  String   // e.g., 'hero', 'quote', 'couple', 'event', 'countdown', 'location', 'gallery', 'story', 'gift', 'rsvp', 'wishes', 'closing'
  contentJson  Json     // Nested JSON storing array of layers, absolute positions, animations, styling & timelines
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([templateId, sectionOrder])
  @@index([templateId])
  @@map("template_sections")
}

model UserInvitation {
  id            String   @id @default(cuid())
  userId        String   // Client owner ID
  templateId    String
  template      Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title         String   @default("My Wedding Invitation")
  slug          String?  @unique
  brideName     String?
  groomName     String?
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  overrides     Json     @default("{}") // Stores ONLY text/image replacements keyed by layerId or fieldKey
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([templateId])
  @@map("user_invitations")
}
